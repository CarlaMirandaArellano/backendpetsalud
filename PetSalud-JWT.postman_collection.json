{
  "info": {
    "name": "PetSalud JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Registro cliente",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/registro",
        "body": { "mode": "raw", "raw": "{\"email\":\"ana@petsalud.cl\",\"password\":\"Clave1234\",\"nombre\":\"Ana\"}" }
      }
    },
    {
      "name": "2. Login (guarda el token)",
      "event": [{
        "listen": "test",
        "script": { "exec": ["if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().token); }"] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": { "mode": "raw", "raw": "{\"email\":\"ana@petsalud.cl\",\"password\":\"Clave1234\"}" }
      }
    },
    {
      "name": "3. Productos sin token (401)",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/productos" }
    },
    {
      "name": "4. Productos con token (200)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/productos"
      }
    },
    {
      "name": "5. Crear producto como CLIENTE (403)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/productos",
        "body": { "mode": "raw", "raw": "{\"nombre\":\"Alimento\",\"precio\":1000,\"stock\":5,\"categoria\":\"Alimentos\"}" }
      }
    },
    {
      "name": "6. Expediente como CLIENTE (403)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/expedientes/1"
      }
    }
  ]
}
